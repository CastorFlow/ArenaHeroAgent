# The recommended Dashboard flow asks for the API Key in the browser and does
# not need this variable. Uncomment only for direct CLI play.
# ARENA_HERO_API_KEY=

# Optional endpoint overrides for a compatible Arena Hero server.
# ARENA_HERO_BASE_URL=http://localhost:8080
# ARENA_HERO_WEBSOCKET_URL=ws://localhost:8080/api/v1/game/ws

# Dashboard defaults. Keep the application on loopback and use HTTPS reverse proxying.
# ARENA_HERO_DASHBOARD_HOST=127.0.0.1
# ARENA_HERO_DASHBOARD_PORT=8766
# ARENA_HERO_AGENT_START_TIMEOUT=25
# ARENA_HERO_DASHBOARD_TRUST_PROXY=true

# Optional runtime-file overrides.
# ARENA_HERO_MEMORY_FILE=.arena_hero_memory.json
# ARENA_HERO_TELEMETRY_FILE=arena_hero_telemetry.jsonl
# ARENA_HERO_STATS_FILE=.arena_hero_stats.json
# ARENA_HERO_EVENT_LOG_FILE=arena_hero_events_zh.jsonl
# ARENA_HERO_CONTROL_FILE=.arena_hero_control.json
# ARENA_HERO_BROWSER_INTEL_FILE=.arena_hero_browser_intel.json
# ARENA_HERO_RECOVERY_TARGETS_FILE=.arena_hero_recovery_targets.json
