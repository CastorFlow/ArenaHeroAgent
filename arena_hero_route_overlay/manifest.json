{
  "manifest_version": 3,
  "name": "Arena Hero Agent Route Overlay",
  "version": "1.2.0",
  "description": "Agent routes, unit labels, resources, live status bar, stats panel, and mode/recall controls.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Arena Hero Agent Route Overlay"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.arenahero.io/*"
      ],
      "js": [
        "overlay-core.js",
        "overlay-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://app.arenahero.io/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
